@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject FactoryAuthService AuthSvc
@implements IDisposable

@if (AuthSvc.IsLoggedIn)
{
    <div class="pos-shell">
        <nav class="sidebar">
            <div class="sidebar-brand">
                <span class="brand-icon">F</span>
                <span class="brand-name">Husna Aijaz Factory</span>
            </div>
            <ul class="nav-links">
                @NavItem("/dashboard", "Dashboard")
                @NavItem("/", "Orders (Stages)")
                @NavItem("/factory-orders", "Per-Item Tracking")
                <li class="nav-section">OUTSOURCING</li>
                @NavItem("/outsourcing", "Outsourced Items")
                @NavItem("/outsource-settings", "Settings")
                <li class="nav-section">OTHER</li>
                @NavItem("/customers", "Customers")
            </ul>
            <div class="sidebar-footer">
                <div class="logged-in-user">
                    <div class="user-avatar">@(AuthSvc.FullName?.Length > 0 ? AuthSvc.FullName.Substring(0,1).ToUpper() : "F")</div>
                    <div>
                        <div class="user-name">@(AuthSvc.FullName)</div>
                        <div class="user-role">Factory Staff</div>
                    </div>
                </div>
                <button class="logout-btn" @onclick="Logout">Logout</button>
            </div>
        </nav>
        <main class="main-content">@Body</main>
    </div>
}
else
{
    <div style="display:none"></div>
}

@code {
    protected override void OnInitialized()
    {
        AuthSvc.OnAuthChanged += OnAuthStateChanged;
        if (!AuthSvc.IsLoggedIn)
        {
            var current = Nav.ToBaseRelativePath(Nav.Uri);
            if (!current.Equals("login", StringComparison.OrdinalIgnoreCase))
                Nav.NavigateTo("/login", forceLoad: false);
        }
    }

    void OnAuthStateChanged()
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
            if (!AuthSvc.IsLoggedIn)
                Nav.NavigateTo("/login", forceLoad: false);
        });
    }

    public void Dispose() => AuthSvc.OnAuthChanged -= OnAuthStateChanged;

    RenderFragment NavItem(string path, string label) => builder =>
    {
        var current = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        var isActive = (current == path || (path == "/" && current == "")) ? "active" : "";
        builder.OpenElement(0, "li");
        builder.OpenElement(1, "a");
        builder.AddAttribute(2, "href", path);
        builder.AddAttribute(3, "class", isActive);
        builder.AddContent(4, label);
        builder.CloseElement();
        builder.CloseElement();
    };

    void Logout() { AuthSvc.Logout(); Nav.NavigateTo("/login", forceLoad: true); }
}
