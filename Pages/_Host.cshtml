@page "/"
@namespace HusnaFactory.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Husna Aijaz Factory</title>
    <base href="~/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="css/app.css" />
    <!-- print.js MUST load before Blazor so JS interop calls never find it undefined -->
    <script src="/js/print.js"></script>
    <script src="/js/debounce.js"></script>
    <script>
        function toggleSidebar(){
            var el=document.getElementById('posShell');
            if(!el)return;
            el.classList.toggle('sidebar-collapsed');
            try{localStorage.setItem('sb-collapsed',el.classList.contains('sidebar-collapsed')?'1':'0')}catch(e){}
        }
        // Restore collapsed state on load and after Blazor reconnect
        function _applySidebarState(){
            var el=document.getElementById('posShell');
            if(!el)return;
            try{if(localStorage.getItem('sb-collapsed')==='1')el.classList.add('sidebar-collapsed')}catch(e){}
        }
        document.addEventListener('DOMContentLoaded',_applySidebarState);
    </script>
</head>
<body>
    <component type="typeof(App)" render-mode="Server" />
    <script src="_framework/blazor.server.js"></script>
</body>
</html>
