@page "/outsourcing"
@inject FactoryOrderService OrderSvc
@inject FactoryCacheService CacheSvc
@inject FactoryAuthService AuthSvc

<div class="page-header">
    <h1>Outsourced Items</h1>
    <p>Track outsourced garments &mdash; give fabric, collect for trial, deliver</p>
</div>
@if (!string.IsNullOrEmpty(Msg)) { <div class="alert @(IsErr ? "alert-error" : "alert-success")">@Msg</div> }

<div class="tab-bar">
    <button class="tab-btn @(Filter==""?"active":"")" @onclick='()=>Filter=""'>All</button>
    <button class="tab-btn @(Filter=="Pending"?"active":"")" @onclick='()=>Filter="Pending"'>Pending</button>
    <button class="tab-btn @(Filter=="Sent to Factory"?"active":"")" @onclick='()=>Filter="Sent to Factory"'>Fabric Given</button>
    <button class="tab-btn @(Filter=="In Progress"?"active":"")" @onclick='()=>Filter="In Progress"'>In Progress</button>
    <button class="tab-btn @(Filter=="Sent for Trial"?"active":"")" @onclick='()=>Filter="Sent for Trial"'>Trial Ready</button>
    <button class="tab-btn @(Filter=="Completed"?"active":"")" @onclick='()=>Filter="Completed"'>Completed</button>
</div>

<div class="card" style="padding:10px;margin-bottom:10px">
    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
        <select class="form-control" style="width:160px" @bind="GarmentFilter">
            <option value="">All Garment Types</option>
            @foreach (var gt in GarmentTypes)
            {
                <option>@gt</option>
            }
        </select>
        <input class="form-control" placeholder="Search customer or vendor..." style="flex:1;min-width:150px" @bind="SearchText" />
    </div>
</div>

<div class="card">
    <div class="table-wrap"><table>
        <thead><tr><th>Order#</th><th>Branch</th><th>Item</th><th>Garment</th><th>Customer</th><th>Vendor</th><th>Booking</th><th>Trial</th><th>Delivery</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>
            @foreach (var order in FilteredOrders)
            {
                foreach (var item in order.Items.Where(i => MatchFilter(i)))
                {
                    <tr>
                        <td style="font-weight:600">#@order.OrderId</td>
                        <td style="font-size:11px;color:#888">@order.BranchLabel</td>
                        <td style="font-weight:500">@item.ProductName <span style="color:var(--ink-faint);font-size:11px">x@(item.ActiveQty)</span>@if(item.CancelledQty > 0){<span style="color:var(--rust);font-size:10px;margin-left:3px">(@item.CancelledQty cancelled)</span>}</td>
                        <td><span class="badge badge-info">@(item.GarmentType ?? "—")</span></td>
                        <td>@order.CustomerName</td>
                        <td style="white-space:nowrap">
                            @if (IsEditingVendor(order, item))
                            {
                                <div style="display:flex;gap:4px;align-items:center">
                                    <input @ref="_vendorInput" id="vendor-@(order.BranchKey)-@(item.OrderItemId)" class="form-control"
                                           style="width:150px;padding:3px 6px;font-size:12px" list="vendorNames" maxlength="50"
                                           placeholder="Vendor name" @bind="VendorInput" @bind:event="oninput"
                                           @onkeydown="e => VendorKey(e, order, item)" />
                                    <button class="btn btn-primary btn-sm" style="padding:3px 10px" disabled="@_busy" @onclick="() => SaveVendor(order, item)">Save</button>
                                    <button class="btn btn-ghost btn-sm" style="padding:3px 8px" title="Cancel" @onclick="CancelVendor">✕</button>
                                </div>
                            }
                            else
                            {
                                var hasVendor = !string.IsNullOrWhiteSpace(item.OutsourceVendor);
                                <button type="button" title="@(hasVendor ? "Change vendor" : "Set vendor")"
                                        style="background:none;border:0;padding:2px 0;font:inherit;cursor:pointer;text-align:left;color:@(hasVendor ? "var(--ink)" : "var(--ink-muted)");text-decoration:underline dotted"
                                        @onclick="() => StartEditVendor(order, item)">
                                    @(hasVendor ? item.OutsourceVendor : "+ Set vendor") <span style="font-size:11px;opacity:.7">✎</span>
                                </button>
                            }
                        </td>
                        <td style="font-size:11px">@order.CreatedAt.ToString("dd MMM")</td>
                        <td style="font-size:11px">@(order.TrialDate?.ToString("dd MMM") ?? "—")</td>
                        <td style="font-size:11px">@(order.DeliveryDate?.ToString("dd MMM") ?? "—")</td>
                        <td><span class="badge @StatusBadge(item.ItemStatus)">@StatusLabel(item.ItemStatus)</span></td>
                        <td style="white-space:nowrap">
                            @StatusSelect(order, item, "width:150px;padding:4px 6px;font-size:12px;display:inline-block")
                            <button class="btn btn-ghost btn-sm" style="margin-left:4px" @onclick="() => OpenItem(order, item)">View</button>
                        </td>
                    </tr>
                }
            }
            @if (!FilteredOrders.Any())
            {
                <tr><td colspan="11" style="text-align:center;color:var(--ink-faint);padding:24px">No outsourced items found.</td></tr>
            }
        </tbody>
    </table></div>
    <datalist id="vendorNames">
        @foreach (var v in KnownVendors) { <option value="@v"></option> }
    </datalist>
</div>

@if (SelectedItem != null && SelectedOrder != null)
{
    var so = SelectedOrder;
    var si = SelectedItem;
    <div class="modal-overlay" @onclick="CloseItem">
        <div class="modal-box" style="max-width:680px" @onclick:stopPropagation>
            <div class="modal-header">
                <h2>Order #@so.OrderId &mdash; @si.ProductName ×@si.ActiveQty</h2>
                <button class="btn btn-ghost btn-sm" @onclick="CloseItem">&#10005;</button>
            </div>
            <div class="modal-body">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:14px">
                    <div class="info-row"><span class="lbl">Status</span><span class="val"><span class="badge @StatusBadge(si.ItemStatus)">@StatusLabel(si.ItemStatus)</span></span></div>
                    <div class="info-row"><span class="lbl">Vendor</span><span class="val">@(string.IsNullOrWhiteSpace(si.OutsourceVendor) ? "— not set —" : si.OutsourceVendor)</span></div>
                    <div class="info-row"><span class="lbl">Customer</span><span class="val">@so.CustomerName</span></div>
                    <div class="info-row"><span class="lbl">Branch</span><span class="val">@so.BranchLabel</span></div>
                    <div class="info-row"><span class="lbl">Booked</span><span class="val">@so.CreatedAt.ToString("dd MMM yyyy")</span></div>
                    <div class="info-row"><span class="lbl">Trial</span><span class="val">@(so.TrialDate?.ToString("dd MMM yyyy") ?? "—")</span></div>
                    <div class="info-row"><span class="lbl">Delivery</span><span class="val">@(so.DeliveryDate?.ToString("dd MMM yyyy") ?? "—")</span></div>
                    @if (!string.IsNullOrEmpty(si.ItemNotes))
                    {
                        <div class="info-row"><span class="lbl">Item notes</span><span class="val">@si.ItemNotes</span></div>
                    }
                </div>

                <div class="section-divider">Change Status</div>
                @StatusSelect(so, si, "max-width:280px")

                <div class="section-divider" style="margin-top:18px">Status History</div>
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Status</th><th>Date &amp; Time</th><th>Changed By</th></tr></thead>
                        <tbody>
                            @foreach (var h in ItemHistory)
                            {
                                <tr>
                                    <td><span class="badge @StatusBadge(h.Stage)">@StatusLabel(h.Stage)</span></td>
                                    <td style="font-size:12px">@ToPkt(h.ChangedAt).ToString("dd MMM yyyy, hh:mm tt")</td>
                                    <td style="font-size:12px;color:var(--ink-muted)">@(h.ChangedBy ?? "—")</td>
                                </tr>
                            }
                            @if (!ItemHistory.Any())
                            {
                                <tr><td colspan="3" style="text-align:center;color:var(--ink-faint);padding:12px">No status changes recorded yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="section-divider" style="margin-top:18px">Remarks</div>
                @if (ItemRemarks.Any())
                {
                    @foreach (var remark in ItemRemarks)
                    {
                        <div style="padding:8px;margin-bottom:6px;background:var(--surface-2);border:1px solid var(--border);border-radius:6px">
                            <div style="display:flex;justify-content:space-between;margin-bottom:3px">
                                <span class="badge @(remark.RemarkType == "trial" ? "badge-warning" : "badge-info")">@(remark.RemarkType ?? "general")</span>
                                <span style="font-size:10px;color:var(--ink-faint)">@ToPkt(remark.CreatedAt).ToString("dd MMM yyyy, hh:mm tt") — @(remark.CreatedBy ?? "—")</span>
                            </div>
                            <p style="font-size:12px;color:var(--ink);margin:0">@remark.RemarkText</p>
                        </div>
                    }
                }
                else
                {
                    <p style="color:var(--ink-faint);text-align:center;padding:12px">No remarks yet.</p>
                }
                <div style="margin-top:10px;display:flex;gap:6px">
                    <input class="form-control" placeholder="Add a remark..." style="flex:1" @bind="NewRemarkText" />
                    <button class="btn btn-primary btn-sm" @onclick="AddRemark">Add</button>
                </div>
            </div>
            <div class="modal-footer"><button class="btn btn-ghost" @onclick="CloseItem">Close</button></div>
        </div>
    </div>
}

@code {
    List<FactoryOrder> AllOrders = new();
    string Filter = "";
    string GarmentFilter = "";
    string SearchText = "";
    FactoryOrderItem? SelectedItem;
    FactoryOrder? SelectedOrder;
    List<OrderItemRemark> ItemRemarks = new();
    List<string> GarmentTypes = new();
    (string Branch, int ItemId)? EditingVendor;
    string VendorInput = "";
    List<string> KnownVendors = new();
    ElementReference _vendorInput;
    bool _focusVendor;
    string NewRemarkText = "";
    string Msg = "";
    bool IsErr;
    bool _busy;
    int _statusTick;
    List<FactoryStatusHistory> ItemHistory = new();

    static readonly (string Value, string Label)[] OutsourceStatuses =
    {
        ("Pending", "Pending"), ("Sent to Factory", "Fabric Given"), ("In Progress", "In Progress"),
        ("Sent for Trial", "Sent for Trial"), ("Completed", "Completed"), ("Sent to Shop", "Sent to Shop")
    };

    // Timestamps are stored in UTC; Pakistan is a fixed UTC+5.
    static DateTime ToPkt(DateTime utc) => utc.AddHours(5);

    // The key changes after every attempt, so a refused or failed change never leaves
    // the dropdown showing a status that wasn't saved.
    RenderFragment StatusSelect(FactoryOrder order, FactoryOrderItem item, string style) =>
        @<select @key="@($"{order.BranchKey}-{item.OrderItemId}-{item.ItemStatus}-{_statusTick}")"
                 class="form-control" style="@style" disabled="@_busy"
                 @onchange="e => ChangeStatus(order, item, e.Value?.ToString() ?? item.ItemStatus)">
            @if (!OutsourceStatuses.Any(s => s.Value == item.ItemStatus))
            {
                <option value="@item.ItemStatus" selected>@StatusLabel(item.ItemStatus) (current)</option>
            }
            @foreach (var s in OutsourceStatuses)
            {
                <option value="@s.Value" selected="@(s.Value == item.ItemStatus)">@s.Label</option>
            }
        </select>;

    IEnumerable<FactoryOrder> FilteredOrders => AllOrders
        .Where(o => string.IsNullOrEmpty(SearchText) ||
            o.CustomerName.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
            o.Items.Any(i => !string.IsNullOrEmpty(i.OutsourceVendor) &&
                i.OutsourceVendor.Contains(SearchText, StringComparison.OrdinalIgnoreCase)))
        .Where(o => o.Items.Any(i => MatchFilter(i)));

    bool MatchFilter(FactoryOrderItem i)
    {
        if (!string.IsNullOrEmpty(Filter) && i.ItemStatus != Filter) return false;
        if (!string.IsNullOrEmpty(GarmentFilter) && i.GarmentType != GarmentFilter) return false;
        if (i.ItemStatus is "Delivered" or "Cancelled") return false;
        return true;
    }

    string StatusBadge(string s) => s switch
    {
        "Pending" => "badge-muted",
        "Sent to Factory" => "badge-info",
        "In Progress" => "badge-warning",
        "Sent for Trial" => "badge-purple",
        "Completed" => "badge-success",
        "Sent to Shop" => "badge-success",
        _ => "badge-info"
    };

    string StatusLabel(string s) => s switch
    {
        "Sent to Factory" => "Fabric Given",
        _ => s
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    async Task LoadOrders()
    {
        AllOrders = await CacheSvc.GetOutsourcedOrdersAsync();
        GarmentTypes = AllOrders
            .SelectMany(o => o.Items)
            .Where(i => !string.IsNullOrEmpty(i.GarmentType))
            .Select(i => i.GarmentType!)
            .Distinct().OrderBy(x => x).ToList();
        KnownVendors = AllOrders
            .SelectMany(o => o.Items)
            .Where(i => !string.IsNullOrWhiteSpace(i.OutsourceVendor))
            .Select(i => i.OutsourceVendor!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusVendor) return;
        _focusVendor = false;
        try { await _vendorInput.FocusAsync(); } catch (InvalidOperationException) { }
    }

    async Task ChangeStatus(FactoryOrder order, FactoryOrderItem item, string newStatus)
    {
        if (_busy || newStatus == item.ItemStatus) { _statusTick++; return; }
        _busy = true;
        try
        {
            await OrderSvc.UpdateItemStatusAsync(order.BranchKey, item.OrderItemId, newStatus,
                AuthSvc.LoggedInUser ?? "factory");
            CacheSvc.Invalidate();
            await LoadOrders();
            await ReselectItem();
            Msg = $"Order #{order.OrderId} · {item.ProductName} → {StatusLabel(newStatus)}."; IsErr = false;
        }
        catch (Exception ex) { Msg = $"Could not update the status: {ex.Message}"; IsErr = true; }
        finally { _busy = false; _statusTick++; }
    }

    async Task OpenItem(FactoryOrder order, FactoryOrderItem item)
    {
        SelectedOrder = order;
        SelectedItem = item;
        NewRemarkText = "";
        ItemHistory = await OrderSvc.GetItemStatusHistoryAsync(order.BranchKey, item.OrderItemId);
        ItemRemarks = await OrderSvc.GetRemarksAsync(order.BranchKey, item.OrderItemId);
    }

    void CloseItem()
    {
        SelectedItem = null;
        SelectedOrder = null;
        ItemHistory.Clear();
        ItemRemarks.Clear();
    }

    // After a reload the list holds fresh objects; point the open popup at them.
    async Task ReselectItem()
    {
        if (SelectedOrder == null || SelectedItem == null) return;
        var branch = SelectedOrder.BranchKey;
        var itemId = SelectedItem.OrderItemId;
        var order = AllOrders.FirstOrDefault(o => o.BranchKey == branch && o.Items.Any(i => i.OrderItemId == itemId));
        if (order == null) { CloseItem(); return; }
        SelectedOrder = order;
        SelectedItem = order.Items.First(i => i.OrderItemId == itemId);
        ItemHistory = await OrderSvc.GetItemStatusHistoryAsync(branch, itemId);
    }

    // Item ids are only unique within a branch, so the branch is part of the key.
    bool IsEditingVendor(FactoryOrder order, FactoryOrderItem item) =>
        EditingVendor is { } e && e.Branch == order.BranchKey && e.ItemId == item.OrderItemId;

    void StartEditVendor(FactoryOrder order, FactoryOrderItem item)
    {
        EditingVendor = (order.BranchKey, item.OrderItemId);
        VendorInput = item.OutsourceVendor?.Trim() ?? "";
        _focusVendor = true;
    }

    void CancelVendor()
    {
        EditingVendor = null;
        VendorInput = "";
    }

    async Task VendorKey(KeyboardEventArgs e, FactoryOrder order, FactoryOrderItem item)
    {
        if (e.Key == "Enter") await SaveVendor(order, item);
        else if (e.Key == "Escape") CancelVendor();
    }

    async Task SaveVendor(FactoryOrder order, FactoryOrderItem item)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var vendor = VendorInput.Trim();
            if (vendor.Length > 50) { Msg = "Vendor names can be at most 50 characters."; IsErr = true; return; }
            await OrderSvc.UpdateOutsourceVendorAsync(order.BranchKey, item.OrderItemId, vendor);
            item.OutsourceVendor = vendor.Length == 0 ? null : vendor;
            EditingVendor = null;
            CacheSvc.Invalidate();
            await LoadOrders();
            await ReselectItem();
            Msg = vendor.Length == 0
                ? $"Vendor cleared for order #{order.OrderId} · {item.ProductName}."
                : $"Order #{order.OrderId} · {item.ProductName} → vendor {vendor}.";
            IsErr = false;
        }
        catch (Exception ex) { Msg = $"Could not save the vendor: {ex.Message}"; IsErr = true; }
        finally { _busy = false; }
    }

    async Task AddRemark()
    {
        if (SelectedItem == null || SelectedOrder == null || string.IsNullOrWhiteSpace(NewRemarkText)) return;
        await OrderSvc.AddRemarkAsync(SelectedOrder.BranchKey, SelectedOrder.OrderId,
            SelectedItem.OrderItemId, NewRemarkText, "outsource", AuthSvc.LoggedInUser ?? "factory");
        NewRemarkText = "";
        ItemRemarks = await OrderSvc.GetRemarksAsync(SelectedOrder.BranchKey, SelectedItem.OrderItemId);
    }
}
